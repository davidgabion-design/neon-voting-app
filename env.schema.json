{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neon Voting System Environment Variables",
  "type": "object",
  "properties": {
    "APP_URL": {"type": "string", "description": "Absolute base URL of the deployed site (used by server functions)."},

    "FIREBASE_PROJECT_ID": {"type": "string"},
    "FIREBASE_CLIENT_EMAIL": {"type": "string"},
    "FIREBASE_PRIVATE_KEY": {"type": "string", "description": "Firebase service account private key. Use literal \\\n in Netlify for new lines."},

    "SMTP_HOST": {"type": "string"},
    "SMTP_PORT": {"type": "string"},
    "SMTP_USER": {"type": "string"},
    "SMTP_PASS": {"type": "string"},
    "SMTP_FROM": {"type": "string"},

    "TWILIO_ACCOUNT_SID": {"type": "string"},
    "TWILIO_AUTH_TOKEN": {"type": "string"},
    "TWILIO_SENDER_E164": {"type": "string", "description": "Single sender number for both SMS and WhatsApp, E.164 format like +233501234567."},
    "TWILIO_STATUS_CALLBACK_URL": {"type": "string"},

    "TWILIO_TEMPLATE_VOTER_INVITE": {"type": "string"},
    "TWILIO_TEMPLATE_VOTER_OTP": {"type": "string"},
    "TWILIO_TEMPLATE_EC_ACCESS": {"type": "string"},
    "TWILIO_TEMPLATE_ELECTION_APPROVED": {"type": "string"},
    "TWILIO_TEMPLATE_RESULTS_PUBLISHED": {"type": "string"},

    "ENV_DOCTOR_TOKEN": {"type": "string", "description": "Optional shared secret used to restrict access to /.netlify/functions/env-doctor."}
  },
  "required": [
    "APP_URL",
    "FIREBASE_PROJECT_ID",
    "FIREBASE_CLIENT_EMAIL",
    "FIREBASE_PRIVATE_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_SENDER_E164",
    "TWILIO_TEMPLATE_VOTER_INVITE",
    "TWILIO_TEMPLATE_VOTER_OTP",
    "TWILIO_TEMPLATE_EC_ACCESS",
    "TWILIO_TEMPLATE_ELECTION_APPROVED",
    "TWILIO_TEMPLATE_RESULTS_PUBLISHED"
  ],
  "additionalProperties": true
}
