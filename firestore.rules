rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ Helper functions for approval workflow
    function isApprovalEditable(orgData) {
      // Allow editing if status is draft, rejected, or not set
      return !orgData.approval.status 
        || orgData.approval.status == 'draft' 
        || orgData.approval.status == 'rejected';
    }
    
    function isSubmittingForApproval(orgData, incomingData) {
      // Allow EC to submit for approval (change from draft/rejected to pending)
      return (!orgData.approval.status || orgData.approval.status in ['draft', 'rejected'])
        && incomingData.approval.status == 'pending';
    }
    
    function isSuperAdminApprovalChange(orgData, incomingData) {
      // SuperAdmin can change approval status and related fields
      // Allow if approval status is changing from pending to approved/rejected
      // Note: SuperAdmin doesn't use Firebase Auth, so no auth check here
      // Handle both full object replacement and dot-notation updates
      return orgData.keys().hasAny(['approval']) 
        && orgData.approval.keys().hasAny(['status'])
        && orgData.approval.status == 'pending' 
        && incomingData.keys().hasAny(['approval'])
        && incomingData.approval.keys().hasAny(['status'])
        && incomingData.approval.status in ['approved', 'rejected'];
    }

    // Meta collection for super admin credentials
    match /meta/{docId} {
      allow read: if true;  // Allow Super Admin login check
      // Only allow creating meta doc if it doesn't exist (initial setup)
      allow create: if !exists(/databases/$(database)/documents/meta/$(docId));
      // Prevent updates/deletes to protect super admin credentials
      allow update, delete: if false;
    }
    
    // Guidance analytics collection at meta/analytics/guidance_views
    match /meta/analytics/guidance_views/{viewId} {
      allow read: if true;  // Allow Super Admin to view analytics
      allow create: if true; // Allow system to track guidance views
      allow update, delete: if false; // Immutable analytics log
    }
    
    // Activity logs collection at meta/activity/logs
    match /meta/activity/logs/{logId} {
      allow read: if true;  // Allow Super Admin to view activity feed
      allow create: if true; // Allow system to log activities
      allow update, delete: if false; // Immutable activity log
    }
    
    // Audit logs collection at meta/audit/logs
    match /meta/audit/logs/{logId} {
      allow read: if true;  // Allow Super Admin to view audit trail
      allow create: if true; // Allow system to log audit events
      allow update, delete: if false; // Immutable audit log
    }

    // ✅ PATCH 6: Organization-level rules with approval workflow enforcement
    match /organizations/{orgId} {
      // Public read for voter login and results viewing
      allow read: if true;
      
      // ✅ Allow all updates for now (simplified for Super Admin without Firebase Auth)
      // In production, add more specific permission checks
      allow update: if true;
      
      // Allow create for new organizations (EC or SuperAdmin)
      allow create: if true;
      
      // Allow delete for cleanup (in production, restrict to SuperAdmin)
      allow delete: if true;
      allow create: if true;
      
      // Allow delete for cleanup (in production, restrict to SuperAdmin)
      allow delete: if true;

      // ✅ Voters subcollection - ECs can always manage voters (even after approval)
      match /voters/{voterId} {
        allow read: if true; // Public read for voter login
        
        // ECs can create voters anytime (approval status doesn't block voter management)
        // Validate voter has required fields and hasn't voted yet
        allow create: if request.resource.data.keys().hasAny(['email', 'phone'])
                      && request.resource.data.hasVoted == false;
        
        // Allow hasVoted flag update (after voting) OR EC editing during editable period
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasVoted'])
                      || isApprovalEditable(get(/databases/$(database)/documents/organizations/$(orgId)).data);
        
        // Allow delete only during editable period
        allow delete: if isApprovalEditable(get(/databases/$(database)/documents/organizations/$(orgId)).data);
      }

      // ✅ Positions subcollection - ECs can manage positions anytime
      match /positions/{positionId} {
        allow read: if true; // Public read for ballot display
        
        // ECs can create positions anytime (approval status doesn't block position management)
        // Validate position has required fields
        allow create: if request.resource.data.keys().hasAll(['name'])
                      && request.resource.data.name is string;
        
        // Allow updates during editable period
        allow update: if isApprovalEditable(get(/databases/$(database)/documents/organizations/$(orgId)).data);
        
        // Allow deletes during editable period
        allow delete: if isApprovalEditable(get(/databases/$(database)/documents/organizations/$(orgId)).data);
      }

      // ✅ Candidates subcollection - ECs can manage candidates anytime
      match /candidates/{candidateId} {
        allow read: if true; // Public read for ballot display
        
        // ECs can create candidates anytime (approval status doesn't block candidate management)
        // Validate candidate has required fields
        allow create: if request.resource.data.keys().hasAll(['name', 'positionId'])
                      && request.resource.data.name is string
                      && request.resource.data.positionId is string;
        
        // Allow updates during editable period
        allow update: if isApprovalEditable(get(/databases/$(database)/documents/organizations/$(orgId)).data);
        
        // Allow deletes during editable period
        allow delete: if isApprovalEditable(get(/databases/$(database)/documents/organizations/$(orgId)).data);
      }

      // ✅ Votes collection - always writable for voters, read restricted
      match /votes/{voteId} {
        // Voters can read their own votes (by voterId)
        allow read: if true;
        
        // Voters can create votes (one-time voting) - validate structure
        allow create: if request.resource.data.keys().hasAll(['voterId', 'choices', 'timestamp'])
                      && request.resource.data.voterId is string
                      && request.resource.data.choices is map
                      && request.resource.data.timestamp != null;
        
        // Update/delete restricted (prevent vote tampering)
        allow update, delete: if false;
      }

      // ✅ Invites subcollection - track invite sends
      match /invites/{inviteId} {
        allow read: if true; // EC can view invite status
        
        // EC can always send invites (even after approval) - validate structure
        // Note: serverTimestamp() evaluates as null during validation, but becomes timestamp on server
        allow create: if request.resource.data.keys().hasAny(['recipientEmail', 'recipientPhone']);
        
        // Allow status updates
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveredAt', 'errorMessage']);
        
        allow delete: if false; // Preserve invite history
      }

      // ✅ Invite templates - EC can manage when editing allowed
      match /inviteTemplates/{templateId} {
        allow read: if true;
        
        allow write: if isApprovalEditable(get(/databases/$(database)/documents/organizations/$(orgId)).data);
      }

      // ✅ Audit logs - read-only, system-managed
      match /auditLogs/{logId} {
        allow read: if true;  // EC and SuperAdmin can view
        allow create: if true; // System can create
        allow update, delete: if false; // Immutable audit trail
      }
    }
    
    // ✅ Global activity log (if used)
    match /activity/{activityId} {
      allow read: if true;  // SuperAdmin can view
      allow create: if true; // System can create
      allow update, delete: if false; // Immutable activity log
    }

    // ✅ Guidance downloads analytics
    match /guidanceDownloads/{downloadId} {
      allow read: if true;  // SuperAdmin can view analytics
      allow create: if true; // System can track downloads
      allow update, delete: if false; // Immutable analytics log
    }

    // ✅ Administrators collection - manage admin users with roles
    match /administrators/{adminEmail} {
      // Allow read for super admin login and admin management UI
      allow read: if true;
      
      // Validate admin document structure on create
      allow create: if request.resource.data.keys().hasAll(['email', 'role', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.role in ['superadmin', 'admin', 'ec']
                    && request.resource.data.createdAt != null;
      
      // Prevent role elevation or critical field tampering on update
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'createdAt'])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) 
                        || request.resource.data.role in ['admin', 'ec']);
      
      // Allow delete (consider adding protection for last superadmin)
      allow delete: if true;
    }
  }
}