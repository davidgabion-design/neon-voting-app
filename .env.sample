# Neon Voting System - Environment Variables (sample)
# Copy to .env for local use, or set in Netlify: Site settings → Environment variables

# -----------------
# App
# -----------------
APP_URL=

# -----------------
# Firebase Admin SDK (Netlify Functions)
# -----------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# IMPORTANT: keep literal \n sequences in Netlify for multi-line keys
FIREBASE_PRIVATE_KEY=

# -----------------
# SMTP (Email sending)
# -----------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# -----------------
# Twilio (SMS + WhatsApp)
# -----------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Single canonical sender number (E.164). Example: +233501234567
TWILIO_SENDER_E164=
# Optional delivery/status callback endpoint
TWILIO_STATUS_CALLBACK_URL=

# -----------------
# Twilio WhatsApp Content Template SIDs (approved)
# -----------------
TWILIO_TEMPLATE_VOTER_INVITE=
TWILIO_TEMPLATE_VOTER_OTP=
TWILIO_TEMPLATE_EC_ACCESS=
TWILIO_TEMPLATE_ELECTION_APPROVED=
TWILIO_TEMPLATE_RESULTS_PUBLISHED=

# -----------------
# Optional: protect /.netlify/functions/env-doctor in production
# -----------------
ENV_DOCTOR_TOKEN=
